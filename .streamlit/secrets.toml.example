# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App settings → Secrets.
# Never commit the real file.

# --- Core (required) -----------------------------------------------------------
OPENAI_API_KEY = "sk-..."
SEARCH_BACKEND = "sqlite_qdrant"
QDRANT_URL = "https://xxxx.cloud.qdrant.io"
QDRANT_API_KEY = "..."
RAG_ASK_RATE_PER_MINUTE = "5"
RAG_ASK_DAILY_LIMIT = "100"

# --- Extra features ------------------------------------------------------------
# Model used by follow-ups, simpler/deeper versions, study sets, concept maps and reviews.
EXTRAS_LLM_PROVIDER = "openai"        # openai | gemini | groq (free tiers work for gemini/groq)
EXTRAS_LLM_MODEL = ""                 # empty = gpt-4o-mini / gemini-2.5-flash / llama-3.3-70b-versatile
# GEMINI_API_KEY = "..."
# GROQ_API_KEY = "..."

# Share links and feedback storage: supabase | memory (memory = this server process only).
SHARE_BACKEND = "supabase"
SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."           # the public anon key; tables are protected by RLS (see PLAN.md)
APP_URL = "https://paprly.streamlit.app"   # base of share links
REVIEW_DAILY_CAP = "20"               # spaced-review cards per day

# --- Optional tracing ------------------------------------------------------------
# LANGSMITH_TRACING = "true"
# LANGSMITH_API_KEY = "lsv2_..."
# LANGSMITH_PROJECT = "paper-scout-cloud"
