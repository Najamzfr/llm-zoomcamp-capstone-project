
OPENAI_API_KEY=your-openai-api-key-here
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=180
SEARCH_BACKEND=sqlite_faiss
RAG_SEARCH_METHOD=hybrid
RAG_RESULT_COUNT=5
RAG_CHAT_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DATABASE_PATH=data/indexes/arxiv.db
RAG_VECTOR_METADATA_PATH=data/indexes/vector_index.npz
RAG_VECTOR_INDEX_PATH=data/indexes/vector_index.bin
# RRF environment values override config/rrf_config.json.
RAG_RRF_CANDIDATE_K=50
RAG_RRF_CONSTANT=90
RAG_RRF_TEXT_WEIGHT=0.8
RAG_RRF_VECTOR_WEIGHT=0.2
