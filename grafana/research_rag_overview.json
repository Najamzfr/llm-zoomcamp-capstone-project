{
  "title": "Research RAG Overview",
  "uid": "research-rag-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {"id": 1, "title": "Requests / min", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(rate(rag_requests_total[1m])) * 60", "legendFormat": "requests"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "title": "Error rate", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(rate(rag_requests_total{status_class=~\"5xx|4xx\"}[5m])) / clamp_min(sum(rate(rag_requests_total[5m])), 1e-9)", "legendFormat": "errors"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "title": "Latency p50 / p95", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "histogram_quantile(0.50, sum(rate(rag_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum(rate(rag_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 4, "title": "Active requests", "type": "stat", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "rag_active_requests"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}},
    {"id": 5, "title": "Token usage", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(rate(rag_input_tokens_total[5m]))", "legendFormat": "input"}, {"expr": "sum(rate(rag_output_tokens_total[5m]))", "legendFormat": "output"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}},
    {"id": 6, "title": "Cost rate", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(rate(rag_estimated_cost_usd_total[5m]))", "legendFormat": "USD / sec"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}},
    {"id": 7, "title": "Abstract vs full-text", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum by (answer_stage) (rate(rag_answer_stages_total[5m]))", "legendFormat": "{{answer_stage}}"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}},
    {"id": 8, "title": "Full-text retrieval success", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(rate(rag_full_text_retrieval_successes_total[5m])) / clamp_min(sum(rate(rag_full_text_retrieval_attempts_total[5m])), 1e-9)", "legendFormat": "success rate"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}},
    {"id": 9, "title": "Judge outcomes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum by (outcome) (rate(rag_judge_outcomes_total[5m]))", "legendFormat": "{{outcome}}"}], "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}}
  ]
}
